{
	"id": "kaneo",
	"name": "Kaneo",
	"version": "0.3.1",
	"opal": ">=2.0.0-rc.16",
	"main": "dist/plugin.js",
	"summary": "Sync issues and work orders with Kaneo tasks.",
	"permissions": {
		"ops": [
			"issues.list",
			"issues.get",
			"issues.update",
			"issues.start",
			"issues.review",
			"issues.returnFromReview",
			"issues.listComments",
			"issues.addComment",
			"execution.list",
			"execution.get",
			"execution.listComments",
			"execution.addComment"
		],
		"events": [
			"record_changed"
		],
		"hooks": true
	},
	"settings": [
		{
			"key": "url",
			"label": "Kaneo URL",
			"type": "url",
			"required": true
		},
		{
			"key": "apiKey",
			"label": "API key",
			"type": "secret",
			"required": true
		},
		{
			"key": "issueProject",
			"label": "Issue project",
			"type": "select",
			"optionsFrom": "/options/projects"
		},
		{
			"key": "workOrderProject",
			"label": "Work order project",
			"type": "select",
			"optionsFrom": "/options/projects"
		},
		{
			"key": "statusColumns",
			"label": "Status columns",
			"type": "json"
		},
		{
			"key": "publicUrl",
			"label": "OPAL public URL",
			"type": "url"
		},
		{
			"key": "webhookSecret",
			"label": "Webhook secret",
			"type": "secret"
		}
	],
	"panels": [
		{
			"slot": "issue.side",
			"title": "Kaneo",
			"path": "/panel/issue"
		},
		{
			"slot": "execution.side",
			"title": "Kaneo",
			"path": "/panel/execution"
		}
	]
}
